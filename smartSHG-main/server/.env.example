# SmartSHG Server Environment Variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartshg
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay TEST Mode Credentials
# Get from: https://dashboard.razorpay.com/app/keys (switch to TEST mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
