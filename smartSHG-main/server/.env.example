# SmartSHG Server Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

PORT=5000
NODE_ENV=development

# MongoDB — leave blank to use the automatic in-memory MongoMemoryServer
# For a real database: mongodb://localhost:27017/smartshg  or  mongodb+srv://...
MONGODB_URI=

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# ─── Razorpay TEST Mode ───────────────────────────────────────────────────────
# 1. Go to https://dashboard.razorpay.com/app/keys
# 2. Toggle to TEST MODE (top-left of the Razorpay dashboard)
# 3. Click "Generate Test Key" — copy Key ID and Key Secret below
#
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
#
# Webhook secret — only needed if you configure webhooks in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# ─────────────────────────────────────────────────────────────────────────────
